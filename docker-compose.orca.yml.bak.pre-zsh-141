services:
  orca:
    container_name: orca
    labels:
      plugsy.name: "Orca"
      plugsy.category: "Code"
      plugsy.icon: "@styled-icons/feather/Cpu"
      plugsy.link: https://orca.thenairn.com
    build:
      context: ./orca
      args:
        ORCA_VERSION: "1.4.35"
    # Full host management (mirrors jarvis-console): privileged + host PID
    # namespace lets agents nsenter the host; docker.sock drives the stack.
    privileged: true
    pid: host
    shm_size: "512m"
    environment:
      - ELECTRON_DISABLE_SANDBOX=1
      - HOME=/home/orca
      - ORCA_PORT=6768
      - ORCA_PAIRING_ADDRESS=wss://orca.thenairn.com
    volumes:
      # Persisted runtime state + ALL agent logins + runtime-installed tools.
      - /mnt/cache/Config/orca:/home/orca
      # Code + full cache (direct btrfs, no shfs). Repos live under /mnt/cache/HQ.
      - /mnt/cache:/mnt/cache
      # thenairn.com at its registered path, sourced direct (shadows the shfs view).
      - /mnt/cache/Internal/thenairn.com:/mnt/user/Internal/thenairn.com
      # Broad host access for managing the box.
      - /mnt/user:/mnt/user
      - /boot:/boot
      - /var/run/docker.sock:/var/run/docker.sock
      # Host root home, live — entrypoint symlinks its configs (claude/gh/git/ssh)
      # into the container HOME so agents share the host's creds + history.
      - /root:/hostroot
    restart: unless-stopped
