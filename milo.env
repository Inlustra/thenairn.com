# Milo (RainnWorks/milo) on Tower: the site-specific settings, none private.
# Private identifiers (numbers, chat IDs) are in .env; credentials in
# ${CONFIG_DIR}/harness/credentials.json. Used by docker-compose.harness.yml
# and by the replays in `scripts/deploy.sh` (see that repo's deploy.env).
# Values are literal: no quotes, spaces allowed.
HARNESS_STATE=/mnt/user/Config/harness
MEDIA_CWD=/mnt/user/HQ/media
THOR_CWD=/mnt/user/HQ
MILO_VCARD=/mnt/user/HQ/thenairn.com/Playground/milo/milo.vcf

RADARR_URL=http://radarr:7878
RADARR_CONFIG_XML=/mnt/user/Config/radarr/config.xml
RADARR_ROOT=/movies
RADARR_PROFILE=6
SONARR_URL=http://sonarr:8989
SONARR_CONFIG_XML=/mnt/user/Config/sonarr/config.xml
SONARR_ROOT=/tv
SONARR_PROFILE=1
ANIME_RADARR_URL=http://animeradarr:7878
ANIME_RADARR_CONFIG_XML=/mnt/user/Config/animeradarr/config.xml
ANIME_RADARR_ROOT=/movies
ANIME_RADARR_PROFILE=7
ANIME_SONARR_URL=http://animesonarr:8989
ANIME_SONARR_CONFIG_XML=/mnt/user/Config/sonarr_anime/config.xml
ANIME_SONARR_ROOT=/anime
ANIME_SONARR_PROFILE=7
MEDIA_HIDDEN_ROOT=/amedia

PLEX_URL=http://plex:32400
PLEX_PREFS_XML=/mnt/user/Config/plex/Library/Application Support/Plex Media Server/Preferences.xml
PLEX_FILM_SECTIONS=1
PLEX_SERIES_SECTIONS=2
PLEX_ANIME_FILM_SECTIONS=8
PLEX_ANIME_SERIES_SECTIONS=3
PLEX_HIDDEN_SECTIONS=5
