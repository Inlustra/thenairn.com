    # Google SSO flow). 256-bit random; HINDSIGHT_API_TOKEN in .env.
    @token {
        header Authorization "Bearer a5abcee9a972a9cfc90b8b46b5eab53eda147c6172d0ec65b9f2dee112c954e3"
