# ROLES DEFINITION

(admin) {
	authorize with adminpolicy
}

(rowm) {
	authorize with rowmpolicy
}

(superuser) {
	authorize with superuserpolicy
}

(family) {
	authorize with familypolicy
}

(user) {
	authorize with userpolicy
}

# SERVER DEFAULTS

{
    order authenticate before respond
    order authorize before basicauth

    on_demand_tls {
        ask {env.TLS_PERMISSION_ENDPOINT}
    }	

    acme_dns porkbun {
        api_key {env.PORKBUN_API_KEY}
        api_secret_key {env.PORKBUN_SECRET_KEY}	
    }

    security {
		oauth identity provider google {
			realm google
			driver google
			client_id {env.OAUTH_GOOGLE_CLIENT_ID}
			client_secret {env.OAUTH_GOOGLE_CLIENT_SECRET}
			scopes openid email profile
		}

      authentication portal myportal {
			crypto default token lifetime 3600
            crypto key sign-verify {env.JWT_SHARED_KEY}

            enable identity provider google

			cookie domain thenairn.com
            cookie path /

            # Without this, caddy-security SILENTLY IGNORES the redirect_url it
            # was itself given and dumps the user on the portal landing page —
            # the "My Identity" screen — instead of the page they asked for.
            # It affected every gated vhost, on every login, not just one.
            #
            # The authorize policies do their half correctly: an unauthenticated
            # request to e.g. claw.thenairn.com 302s to
            #   …/authorization-code-callback?redirect_url=https%3A%2F%2Fclaw.thenairn.com%2F
            # The portal then discards that parameter unless the target matches
            # a trusted URI, and with no directive present nothing is trusted.
            # Added 2026-09-09.
            #
            # Note `suffix` matches on the string, so it would also trust a
            # hypothetical evilthenairn.com. Every host actually served here is
            # a real subdomain, so tighten to explicit entries if that ever
            # stops being a safe assumption.
            trust login redirect uri domain suffix thenairn.com path prefix /
			ui {
				links {
					"My Identity" "/whoami" icon "las la-user"
				}
			}

			transform user {
				match realm google
				action add role authp/user
			}

            transform user {
				match realm google
                match email thomas@thenairn.com
                action add role authp/admin
            }

            transform user {
				match realm google
                match email thomas@rowm.co
                action add role authp/admin
            }

            transform user {
				match realm google
                match email grace.nairn@gmail.com
                action add role authp/superuser
            }

            transform user {
                match realm google
                match email francesca.nairn@gmail.com
                action add role authp/family
            }

            transform user {
                match realm google
                match email nikkihazell@yahoo.co.uk
                action add role authp/family
            }

            transform user {
                match realm google
                match email haz.nairn@gmail.com
                action add role authp/family
            }
		}

		authorization policy adminpolicy {
            set auth url "https://auth.thenairn.com/oauth2/google/authorization-code-callback"
			crypto key verify {env.JWT_SHARED_KEY}
			allow roles authp/admin
			validate bearer header
			inject headers with claims
		}

		authorization policy superuserpolicy {
            set auth url "https://auth.thenairn.com/oauth2/google/authorization-code-callback"
			crypto key verify {env.JWT_SHARED_KEY}
			allow roles authp/admin authp/superuser
			validate bearer header
			inject headers with claims
		}

		authorization policy userpolicy {
            set auth url "https://auth.thenairn.com/oauth2/google/authorization-code-callback"
			crypto key verify {env.JWT_SHARED_KEY}
			allow roles authp/admin authp/superuser authp/user
			validate bearer header
			inject headers with claims
		}

		authorization policy familypolicy {
            set auth url "https://auth.thenairn.com/oauth2/google/authorization-code-callback"
			crypto key verify {env.JWT_SHARED_KEY}
			allow roles authp/admin authp/family authp/user
			validate bearer header
			inject headers with claims
		}

		authorization policy rowmpolicy {
            set auth url "https://auth.thenairn.com/oauth2/google/authorization-code-callback"
			crypto key verify {env.JWT_SHARED_KEY}
			allow roles authp/admin authp/rowm
			validate bearer header
			inject headers with claims
		}
    }
}

(proxy_error_page) {
    handle_errors {
        header Content-Type text/html
        respond <<HTML
            <!DOCTYPE html>
            <html><head>
            <meta name="viewport" content="width=device-width,initial-scale=1">
            <style>
            body{font-family:-apple-system,system-ui,sans-serif;background:#0a0a0a;color:#e5e5e5;display:flex;justify-content:center;align-items:center;height:100vh;margin:0}
            .box{text-align:center;padding:32px}
            h1{font-size:3rem;margin:0;color:#333}
            p{color:#666;margin-top:8px}
            </style></head>
            <body><div class="box"><h1>{err.status_code}</h1><p>Service unavailable — try again shortly.</p></div></body></html>
HTML
    }
}

 # DOMAINS

# hq.thenairn.com — REMOVED 2026-08-23 (RAI-6 / RAI-7 D7). The HQ control panel
# was retired at Thomas's decision; both source trees moved to
# _retired/hq-control-panel-2026-08-22/ in commit 800f182. Nothing has listened
# on 192.168.96.14:3777 since the agent platform stopped in April, so this vhost
# served only a 502. The hostname now falls through to the same
# connection-refused an unknown subdomain gets, which is the honest answer.

# OpenClaw gateway Control UI, repointed 2026-09-09 at the openclaw-gateway
# service (docker-compose.openclaw.yml). It previously proxied
# 192.168.96.14:18790 with a hardcoded bearer token; nothing had listened there
# since the 2026-04 attempt was retired, and this repo is public, so that token
# was readable on GitHub for months. It is gone from HEAD as of this change but
# is STILL IN THE PUBLIC HISTORY and must be treated as compromised — same
# shape as the HINDSIGHT_API_TOKEN incident in commit 715ae79.
#
# NO @internal BYPASS, DELIBERATELY — unlike almost every other vhost here.
# OpenClaw runs in trusted-proxy auth mode: it has no login of its own and
# takes the caller's identity from a header. A request arriving without that
# header is refused with AUTH_IDENTITY_HEADER_REQUIRED, so a LAN bypass would
# not mean "no login on the LAN", it would mean a hard 401 on the LAN. Every
# request goes through the portal instead; the Google session cookie makes that
# a single click, and LAN and external behave identically.
#
# header_up SETS X-Forwarded-User rather than appending, from the claims
# caddy-security already injected (adminpolicy ends `inject headers with
# claims`, which emits X-Token-User-Email). A spoofed inbound X-Forwarded-User
# is therefore overwritten here, not honoured.
#
# The gateway publishes no host port — 18789 is reachable only from
# thenairncom_default, and openclaw.json trusts only Caddy's address on that
# network. Those two facts are what make trusting a header safe; loosening
# either one breaks the model.
claw.thenairn.com {
    import proxy_error_page
    import admin
    reverse_proxy openclaw-gateway:18789 {
        header_up X-Forwarded-User {http.request.header.X-Token-User-Email}
        header_up X-Forwarded-Proto https
    }
}
# Native OpenClaw companion apps cannot complete the browser-only Google OAuth
# flow used by claw.thenairn.com. This hostname therefore terminates TLS at
# Caddy and forwards only to the loopback-only token bridge sharing Caddy's
# network namespace. The bridge validates connect.params.auth.token before it
# relays a byte to the trusted-proxy Gateway. No Gateway port is published.
claw-native.thenairn.com {
    import proxy_error_page
    reverse_proxy 127.0.0.1:18791 {
        # Overwrite all attribution supplied by the public client. The bridge
        # accepts exactly one syntactically valid address in X-Forwarded-For.
        header_up Host claw-native.thenairn.com
        header_up X-Forwarded-Host claw-native.thenairn.com
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {http.request.remote.host}
        header_up X-Real-IP {http.request.remote.host}
    }
}


