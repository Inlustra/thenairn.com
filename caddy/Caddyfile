# Plugsy renders server-side, and its getServerSideProps calls its OWN GraphQL
# endpoint at whatever public address it believes it is being served on. It
# takes that address from X-Forwarded-Host, which Caddy's reverse_proxy sets
# automatically. So plugsy tries `http://dashboard.thenairn.com/graphql`, which
# from inside the container resolves to 192.168.96.14:80 — a hairpin back out
# through Caddy that never completes. The fetch dies with ECONNRESET, Next.js
# renders its own 500 page, and Caddy faithfully passes back a 500 that is
# neither Caddy's fault nor plugsy being down.
#
# Overriding X-Forwarded-Host to the upstream's own address makes plugsy's
# self-call land on itself. Isolated 2026-08-23 (RAI-6) against plugsy directly,
# one header at a time:
#     no headers ............................................ 200
#     Host: dashboard.thenairn.com .......................... 500
#     X-Forwarded-Host: dashboard.thenairn.com .............. 500
#     Host: plugsy:3000 + X-Forwarded-Host: dashboard ....... 500
#     Host: dashboard + X-Forwarded-Host: plugsy:3000 ....... 200
# The last two lines are the whole finding: X-Forwarded-Host decides, Host does
# not, so this overrides only X-Forwarded-Host. Every link on the dashboard is
# an absolute URL out of autodash.json, so nothing depends on plugsy knowing its
# public name.
dashboard.thenairn.com {
    @internal {
        remote_ip 192.168.0.0/16 172.16.0.0/12 10.0.0.0/8
    }
    handle @internal {
        reverse_proxy plugsy:3000 {
            header_up X-Forwarded-Host {upstream_hostport}
        }
    }
    handle {
        import admin
        reverse_proxy plugsy:3000 {
            header_up X-Forwarded-Host {upstream_hostport}
        }
    }
}

