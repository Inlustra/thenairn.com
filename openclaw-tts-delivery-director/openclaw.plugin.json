{
  "id": "tts-delivery-director",
  "name": "TTS Delivery Director",
  "description": "Adds bounded per-session delivery direction to private Voicebox synthesis.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "speechProviders": [
      "voicebox-directed"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "model": {
        "type": "string",
        "default": "openai/gpt-5.6-luna"
      },
      "directorTimeoutMs": {
        "type": "integer",
        "minimum": 250,
        "maximum": 10000,
        "default": 3000
      },
      "staticInstruction": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "default": "Speak naturally and conversationally, with warm, emotionally appropriate delivery."
      },
      "maxSessions": {
        "type": "integer",
        "minimum": 1,
        "maximum": 512,
        "default": 128
      },
      "sessionTtlMs": {
        "type": "integer",
        "minimum": 60000,
        "maximum": 86400000,
        "default": 1800000
      },
      "recentTurns": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8,
        "default": 6
      },
      "maxTurnChars": {
        "type": "integer",
        "minimum": 80,
        "maximum": 500,
        "default": 280
      }
    }
  }
}
