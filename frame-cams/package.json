{
  "name": "frame-cams",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.tsx",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "compile": "bun build --compile --minify --sourcemap ./src/index.tsx --outfile frame-cams",
    "compile:linux": "bun build --compile --minify --sourcemap --target=bun-linux-x64 ./src/index.tsx --outfile frame-cams",
    "start": "NODE_ENV=production bun src/index.tsx",
    "preview": "bun run build && bun run start"
  },
  "dependencies": {
    "nuqs": "^2.4.3",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest"
  }
}
