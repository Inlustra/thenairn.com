  "wol-macbook": {
    "name": "Wake MacBook",
    "cmd": "nsenter -t 1 -n bun -e \"const s = require('dgram').createSocket('udp4'); s.bind(() => { const mac = Buffer.from('5e88ee575d3d', 'hex'); const msg = Buffer.alloc(102); msg.fill(0xff, 0, 6); for(let i=0;i<16;i++) mac.copy(msg, 6+i*6); s.send(msg, 9, '192.168.99.86', () => { console.log('Magic packet sent to 5E:88:EE:57:5D:3D (192.168.99.86:9)'); s.close(); }); });\"",
    "category": "network",
    "danger": false,
    "icon": "zap"
  },
  "stack-up-all": {
