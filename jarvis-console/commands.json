{
  "openclaw-restart": {
    "name": "Restart OpenClaw Gateway",
    "cmd": "docker restart openclaw-gateway",
    "category": "openclaw",
    "danger": false,
    "icon": "🔄"
  },
  "openclaw-logs": {
    "name": "OpenClaw Logs (last 100)",
    "cmd": "docker logs --tail=100 openclaw-gateway",
    "category": "openclaw",
    "danger": false,
    "icon": "📋"
  },
  "openclaw-status": {
    "name": "OpenClaw Status",
    "cmd": "docker inspect --format '{{.Name}} {{.State.Status}} Up {{.State.StartedAt}}' openclaw-gateway",
    "category": "openclaw",
    "danger": false,
    "icon": "📊"
  },
