  },
  "docker-ps": {
    "name": "All Running Containers",
    "cmd": "docker ps --format \"table {{.Names}}\t{{.Status}}\" | sort",
    "category": "system",
    "danger": false,
    "icon": "🐳"
  },
  "disk-usage": {
    "name": "Disk Usage",
    "cmd": "df -h | grep -E \"^/dev|Filesystem\"",
    "category": "system",
    "danger": false,
    "icon": "💾"
  },
  "docker-stats": {
    "name": "Container Resources",
    "cmd": "docker stats --no-stream --format \"table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\" | sort",
    "category": "system",
    "danger": false,
    "icon": "📈"
  },
  "docker-prune": {
    "name": "Docker Prune (unused images)",
    "cmd": "docker image prune -f",
    "category": "system",
    "danger": true,
    "icon": "🧹"
  },
  "fix-infra-perms": {
    "name": "Fix FRIDAY Workspace Permissions",
    "cmd": "docker run --rm -v /mnt/user/appdata/openclaw/workspaces/nairn-infra:/fix alpine chown 1000:1000 /fix",
    "category": "system",
    "danger": true,
    "icon": "🔧"
  },
  "openclaw-plugins-update": {
    "name": "Update OpenClaw Plugins",
    "cmd": "cd /docker && docker compose run --rm openclaw-cli plugins update --all",
    "category": "openclaw",
    "danger": false,
    "icon": "🔌"
  },
  "openclaw-recreate": {
    "name": "Recreate OpenClaw Gateway",
    "cmd": "docker compose up -d --force-recreate openclaw-gateway",
    "category": "openclaw",
    "danger": true,
    "icon": "♻️"
  },
  "openclaw-teardown": {
    "name": "Tear Down OpenClaw",
    "cmd": "cd /docker && docker compose down openclaw-gateway",
    "category": "openclaw",
    "danger": true,
    "icon": "🔻"
  },
  "jarvis-console-rebuild": {
    "name": "Rebuild Jarvis Console",
    "cmd": "cd /docker && docker compose build jarvis-console && docker compose up -d jarvis-console",
    "category": "system",
    "danger": true,
    "icon": "🔨"
  },
  "jarvis-console-recreate": {
    "name": "Recreate Jarvis Console",
    "cmd": "cd /home/node/.openclaw/workspaces/nairn-infra/docker && docker compose stop jarvis-console && docker compose rm -f jarvis-console && docker compose up -d jarvis-console",
    "category": "system",
    "danger": true,
    "icon": "🤖"
  },
  "stack-up-all": {
    "name": "Whole Stack Up",
    "cmd": "ls -lash && docker compose up -d",
    "category": "system",
    "danger": true,
    "icon": "🚀"
  }
}
