  "go2rtc-restart": {
    "name": "Restart go2rtc",
    "cmd": "docker restart go2rtc",
    "category": "cameras",
    "danger": false,
    "icon": "🔄"
  },
  "go2rtc-logs": {
    "name": "go2rtc Logs (last 50)",
